{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Wolverine": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/hook-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HookDb": ""
  },
  "Whatsapp": {
    "VerifyToken": "",
    "AppSecret": "",
    "PhoneNumberId": "",
    "AccessToken": "",
    "GraphApiVersion": "v22.0"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:3b",
    "Temperature": 0.0,
    "TimeoutSeconds": 120,
    "ReadinessProbeTimeoutSeconds": 10,
    "KeepAlive": "30m"
  },
  "GoogleGeocoding": {
    "ApiKey": ""
  },
  "Chat": {
    "IdleReminderMinutes": 20,
    "IdleEndMinutes": 30,
    "HardExpiryHours": 24
  },
  "Matching": {
    "DefaultRadiusKm": 5,
    "MaxRadiusKm": 100,
    "RadiusExpansionFactor": 2,
    "DistanceWeight": 0.6,
    "RecencyWeight": 0.3,
    "SuccessWeight": 0.1,
    "RecencyHalfLifeHours": 12,
    "ColdStartMinJobs": 3,
    "BroadenedMatchFactor": 0.4,
    "NarrowedMatchFactor": 0.6
  },
  "ServiceTaxonomy": {
    "AutoMergeThreshold": 0.85,
    "AiJudgeThreshold": 0.50
  },
  "ProviderAvailability": {
    "ExpiryHours": 24,
    "RefreshPromptHours": 22,
    "MaxServicesPerProvider": 5
  },
  "RateLimit": {
    "BurstTokens": 3,
    "BurstWindowSeconds": 5,
    "SpamPerHour": 30,
    "AvailabilityPerDay": 10,
    "RequestsPerDay": 20,
    "GlobalWindowSeconds": 5,
    "GlobalPermitLimit": 3,
    "GlobalQueueLimit": 5,
    "WebhookConcurrencyLimit": 50,
    "WebhookQueueLimit": 50,
    "BypassHosts": [ "seq.hook.drop.africa" ]
  },
  "ForwardedHeaders": {
    "KnownNetworks": [ "172.16.0.0/12" ]
  },
  "Retention": {
    "RetentionDays": 7,
    "SweepInterval": "1.00:00:00",
    "StartupDelay": "00:01:00",
    "Enabled": true
  },
  "ReverseProxy": {
    "Routes": {
      "seq": {
        "ClusterId": "seq",
        "Match": { "Hosts": [ "seq.hook.drop.africa" ] }
      }
    },
    "Clusters": {
      "seq": {
        "Destinations": {
          "primary": { "Address": "http://seq/" }
        }
      }
    }
  }
}
