<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hook.csproj" />
    <ProjectReference Include="..\Hook.TestHelpers\Hook.TestHelpers.csproj" />
  </ItemGroup>

  <!-- Wolverine's source generator emits Wolverine.Generated.GeneratedWolverineTypeLoader
       as an internal sealed class in every assembly with handlers. Hook.dll also
       generates one; InternalsVisibleTo("Hook.IntegrationTests") makes Hook's copy
       visible at compile time → CS0436 "type imported from Hook conflicts with local
       type". Wolverine's CompositeWolverineTypeLoader handles both copies at runtime;
       removing the analyzer is not viable here because the test assembly contains
       handlers (AutoApplyTransactionsHandler) that Wolverine discovers via the
       source-generated type manifest. Suppress CS0436 only. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>