# Copy to `.env.prod` (git-ignored) and fill in real values for production deploy.

# --- Public hostname (Caddy uses this for Let's Encrypt) ---
HOOK_DOMAIN=hook.example.com
ACME_EMAIL=ops@example.com

# --- Container image (override per release tag) ---
HOOK_IMAGE=ghcr.io/your-org/hook:latest

# --- Postgres ---
POSTGRES_DB=hook
POSTGRES_USER=hook
POSTGRES_PASSWORD=change-me-strong-random

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v22.0

# --- Ollama (local LLM) ---
# In-compose default points at the `ollama` service on hook-net.
# Override to use an external/GPU host if available.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Google Geocoding ---
GOOGLE_GEOCODING_API_KEY=

# --- Backup retention (days) ---
BACKUP_RETENTION_DAYS=14

# --- Seq (centralized log streaming) ---
# Public hostname for the Seq UI behind Caddy (HTTPS + basic auth).
LOGS_DOMAIN=logs.example.com

# bcrypt hash of the password for the Seq admin user. Generate via:
#   docker run --rm -it datalust/seq config hash
SEQ_FIRSTRUN_ADMINPASSWORDHASH=

# Optional: pre-issue an ingestion API key in Seq UI and paste it here.
# Empty = anonymous ingest (only works inside hook-net).
SEQ_INGEST_API_KEY=

# Internal serverUrl for the API container. Default reaches the seq service via the bridge network.
SEQ_URL=http://seq:5341

# HTTPS basic auth gate in front of the Seq UI.
LOGS_BASIC_AUTH_USER=admin
# bcrypt hash. Generate via:
#   docker run --rm -it caddy caddy hash-password --plaintext 'your-password'
LOGS_BASIC_AUTH_HASH=

# Override target environment for the api service (Production | Staging).
ASPNETCORE_ENVIRONMENT=Production
